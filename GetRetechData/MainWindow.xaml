<Window x:Class="GetRetechData.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GetRetechData"
        mc:Ignorable="d"
        Title="GetRetechData" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Icon="app_icon.png">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnConnect"
                        Content="Cek Koneksi Oracle"
                        Click="BtnConnect_Click"
                        Width="150" Height="35" Margin="0,0,10,0" FontSize="13"/>
                <Button x:Name="BtnLoadData"
                        Content="Load Data"
                        IsEnabled="False"
                        Click="BtnLoadData_Click"
                        Width="100" Height="35" Margin="0,0,10,0" FontSize="13"/>
                <Button x:Name="BtnExport"
                        Content="Export to ZIP"
                        IsEnabled="False"
                        Click="BtnExport_Click"
                        Width="100" Height="35" Margin="0,0,10,0" FontSize="13"/>
            </StackPanel>
            <TextBlock x:Name="TxtStatus"
                       Text="Status: Belum Terhubung"
                       Margin="0,5,0,0"
                       FontSize="13" FontWeight="Bold"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ProgressBar x:Name="ProgressBarExport"
                     Grid.Row="1"
                     Margin="10,0,10,5"
                     Height="20"
                     Minimum="0"
                     Maximum="100"
                     Visibility="Collapsed"/>

        <DataGrid x:Name="DataGridResult"
                  Grid.Row="2"
                  Margin="10,10,10,50"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  AlternatingRowBackground="LightGreen"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="10">
            <Button x:Name="BtnPrev"
                    Content="&lt; Previous"
                    Click="BtnPrev_Click"
                    Width="90" Height="30" Margin="0,0,5,0"
                    IsEnabled="False"/>
            <TextBlock x:Name="TxtPageInfo"
                       Text="Page 0 of 0"
                       VerticalAlignment="Center"
                       FontSize="13" FontWeight="Bold"
                       Margin="5,0"/>
            <Button x:Name="BtnNext"
                    Content="Next >"
                    Click="BtnNext_Click"
                    Width="90" Height="30" Margin="5,0,0,0"
                    IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
